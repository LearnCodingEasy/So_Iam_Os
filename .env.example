# SO_IAM_OS local environment
DJANGO_ENV=local
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
AI_CREDENTIAL_ENCRYPTION_KEY=generate-a-separate-stable-32-plus-character-secret

WEBSITE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# sqlite3 for local; postgresql for production
DATABASE_ENGINE=sqlite3
POSTGRES_DB=so_iam_os
POSTGRES_USER=so_iam_os
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

AI_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
CODEX_OPENAI_MODEL=gpt-5-mini

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

SO_IAM_OS_DEBUG_CONSOLE=false
AUTOMATION_EXECUTION_ENABLED=true
AUTOMATION_REQUIRE_CONFIRMATION=true
CHANNEL_LAYERS_BACKEND=memory
# Set to redis when channels-redis + Redis are available.

# AI reliability / fallback policy
AI_MAX_PROVIDER_ATTEMPTS=5
AI_MAX_RETRIES_PER_PROVIDER=1
AI_TOTAL_DEADLINE_SECONDS=60
AI_RETRY_BACKOFF_SECONDS=0.75
AI_PROVIDER_TIMEOUT_SECONDS=35
AI_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
AI_MODEL_DISCOVERY_TIMEOUT_SECONDS=8
AI_PROVIDER_TEST_TIMEOUT_SECONDS=20
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
